  <bpmn:process id="Process_1k5c7iv" isExecutable="true">
    <bpmn:startEvent id="Start" name="Заказ создан">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="WaitGateway" name="Что случится раньше?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="PaymentReceived" name="Оплата получена">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="PaymentReceived_def" messageRef="Msg_PaymentReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="PaymentTimeout" name="Прошло 15 минут">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="PaymentTimeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="NotifyShop" name="Передать заказ магазину">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-shop" />
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CancelOrder" name="Отменить заказ: «Не оплачен»">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cancel-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndPaid" name="Заказ оплачен">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndCancelled" name="Заказ отменён">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="WaitGateway" />
    <bpmn:sequenceFlow id="F2" sourceRef="WaitGateway" targetRef="PaymentReceived" />
    <bpmn:sequenceFlow id="F3" sourceRef="WaitGateway" targetRef="PaymentTimeout" />
    <bpmn:sequenceFlow id="F4" sourceRef="PaymentReceived" targetRef="NotifyShop" />
    <bpmn:sequenceFlow id="F5" sourceRef="PaymentTimeout" targetRef="CancelOrder" />
    <bpmn:sequenceFlow id="F6" sourceRef="NotifyShop" targetRef="EndPaid" />
    <bpmn:sequenceFlow id="F7" sourceRef="CancelOrder" targetRef="EndCancelled" />
    <bpmn:startEvent id="Event_19akb8h" name="Заказ оплачен">
      <bpmn:outgoing>Flow_0x2hb7t</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="AcceptOrder" name="Принять заказ">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="shop" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0x2hb7t</bpmn:incoming>
      <bpmn:outgoing>Flow_1a62azp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SmsOwner" name="SMS владельцу: заказ не принят (US-01)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="sms-shop-owner" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0gzrb42</bpmn:incoming>
      <bpmn:outgoing>Flow_13u4nnt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0j7jjxg" name="Отменить заказ: «Магазин не подтвердил»">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cancel-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0odqil1</bpmn:incoming>
      <bpmn:outgoing>Flow_0yezi8x</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndAccepted" name="Заказ принят">
      <bpmn:incoming>Flow_1a62azp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndReminded" name="Владелец уведомлён">
      <bpmn:incoming>Flow_13u4nnt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_0kycjqb" name="Заказ отменён">
      <bpmn:incoming>Flow_0yezi8x</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timeout10" name="10 минут" attachedToRef="AcceptOrder">
      <bpmn:outgoing>Flow_0odqil1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timeout10_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Remind7" name="7 минут" cancelActivity="false" attachedToRef="AcceptOrder">
      <bpmn:outgoing>Flow_0gzrb42</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Remind7_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT7M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
