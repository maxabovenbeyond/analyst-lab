    <bpmn:serviceTask id="CallMain" name="Вызвать курьера (MAIN)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="call-courier" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;MAIN&#34;" target="provider" />
          <zeebe:input source="=order_id" target="order_id" />
          <zeebe:output source="=courier_id" target="courier_id" />
