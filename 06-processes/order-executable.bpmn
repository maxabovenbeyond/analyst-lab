      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1dzg5s9</bpmn:incoming>
      <bpmn:outgoing>Flow_0eoxrhv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CallBackup" name="Вызвать курьера (BACKUP)">
