@startuml c4-context
!include <C4/C4_Context>

title Сервис доставки из локальных магазинов — контекст

Person(client, "Клиент", "Заказывает товары местных магазинов")
Person(staff, "Сотрудник магазина", "Принимает и собирает заказы")
Person(owner, "Владелец магазина", "Подключает магазин, смотрит метрики")
Person(support, "Оператор поддержки", "Разбирает претензии, делает возвраты")

System(service, "Сервис доставки", "Каталог, заказы, оплата, статусы, претензии")

System_Ext(payment, "Платёжный провайдер", "Приём оплаты картой и СБП, возвраты")
System_Ext(delivery, "Служба доставки (основная)", "Курьеры, доставка заказов")
System_Ext(delivery_backup, "Служба доставки (резервная)", "Используется при отказе основной")
System_Ext(sms, "SMS-шлюз", "Отправка SMS")

Rel(client, service, "Выбирает товары, оформляет и оплачивает заказ, оставляет оценку", "Веб-браузер, HTTPS")
Rel(staff, service, "Принимает заказы, отмечает сборку, загружает каталог", "Веб-браузер, HTTPS")
Rel(owner, service, "Подключает магазин, смотрит метрики", "Веб-браузер, HTTPS")
Rel(support, service, "Смотрит историю заказа, разбирает претензии, делает возвраты", "Веб-браузер, HTTPS")

Rel(service, payment, "Создаёт платёж, запрашивает возврат", "REST/HTTPS")
Rel(payment, service, "Сообщает о результате оплаты и возврата", "Webhook, HTTPS")

Rel(service, delivery, "Создаёт и отменяет заявки на доставку", "REST/HTTPS")
Rel(service, delivery_backup, "Создаёт заявки при отказе основной службы", "REST/HTTPS")
Rel(delivery, service, "Сообщает статусы доставки: курьер назначен, забрал, доставил", "Webhook, HTTPS")
Rel(delivery_backup, service, "Сообщает статусы доставки", "Webhook, HTTPS")

Rel(service, sms, "Отправляет SMS владельцам магазинов и клиентам", "REST/HTTPS")


' Допишите связи:
' - сотрудник магазина → сервис
' - владелец магазина → сервис
' - оператор поддержки → сервис
' - платёжный провайдер → сервис (как провайдер сообщает об оплате?)
' - сервис → основная служба доставки
' - сервис → резервная служба доставки
' - служба доставки → сервис (как мы узнаём, что курьер забрал заказ?)
' - сервис → SMS-шлюз

SHOW_LEGEND()
@enduml